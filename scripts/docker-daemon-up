#!/data/data/com.termux/files/usr/bin/bash
# docker-daemon-up — garante o daemon udockerd (API do Docker em userspace) no ar.
#
# Idempotente: se a API responde, sai na hora. Sobe desgarrado (setsid, PPid 1)
# para sobreviver ao fim da sessao do Hermes/Termux, com pidfile proprio.
#
# TRANSPORTE: socket Unix em ~/.udockerd/docker.sock, modo 0600 — NAO TCP.
# Motivo: a API do Docker nao autentica ninguem. Num servidor multiusuario o
# loopback ja e restrito, mas **no Android nao e**: qualquer app com permissao de
# rede alcanca 127.0.0.1:2375 e manda no daemon (roda container, monta volume do
# Termux, le arquivo seu). O socket Unix tem a protecao que falta no TCP: a
# permissao do arquivo, que so o dono do Termux tem.
# DOCKER_DAEMON_TCP=1 volta ao transporte antigo (nao recomendado).
#
# udockerd implementa a API do Docker (create/start/stop/rm/exec/logs/TTY/build)
# dirigindo o udocker; a execucao real e proot 5.1 (via shim em ~/.udocker/bin).

set -u
BASE="${DOCKER_TERMUX_HOME:-$HOME/docker-termux}"
MEUBIN="${DOCKER_TERMUX_BIN:-$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")}"
VENV="$BASE/venv-udockerd"
UDOCKERD="$VENV/bin/udockerd"
UDOCKERD_UNIX="$MEUBIN/udockerd-unix"
STATE="$BASE/state"
LOG="$BASE/logs/udockerd.log"
PIDFILE="$STATE/udockerd.pid"
SOCKET="${UDOCKERD_SOCKET:-$HOME/.udockerd/docker.sock}"
PORTA="${DOCKER_DAEMON_PORT:-2375}"
TCP="${DOCKER_DAEMON_TCP:-0}"
LOCK="$STATE/udockerd.lock"           # diretorio (fallback sem flock)
LOCKF="$STATE/udockerd.flock"         # arquivo do flock
# A secao critica pode passar de 30 s (ping 2 s + espera de um pid antigo 10 s
# + daemon TCP legado ~4 s + 15 s de subida): quem espera o lock espera mais.
ESPERA_LOCK="${DOCKER_DAEMON_LOCK_ESPERA:-90}"
# nameservers dos containers do daemon (mesma variavel do docker-direct)
DNS_ARGS=()
for n in $(printf '%s' "${DOCKER_TERMUX_DNS:-8.8.8.8,8.8.4.4}" | tr ',' ' '); do
    case "$n" in
        *[!0-9a-fA-F.:]*|'') echo "aviso: DOCKER_TERMUX_DNS: '$n' ignorado" >&2 ;;
        *) DNS_ARGS+=(--dns "$n") ;;
    esac
done
[ ${#DNS_ARGS[@]} -gt 0 ] || DNS_ARGS=(--dns 8.8.8.8 --dns 8.8.4.4)

mkdir -p "$STATE" "$BASE/logs"

# PID + starttime: o pidfile guarda "pid starttime" (campo 22 do
# /proc/<pid>/stat). Depois de um reboot o numero e reciclado; sem conferir a
# assinatura, o down mandava SIGTERM para o GRUPO de um processo inocente
# (o docker-direct ja fazia essa conferencia; o daemon nao).
starttime_de() {
    local linha
    linha=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
    linha="${linha##*) }"           # o nome do processo pode ter espaco e ')'
    # shellcheck disable=SC2086
    set -- $linha
    [ $# -ge 20 ] && printf '%s' "${20}"
}

# imprime o pid do pidfile SE ele ainda for o mesmo processo e for o udockerd
pid_do_daemon() {
    local pid st atual
    [ -f "$PIDFILE" ] || return 1
    read -r pid st < "$PIDFILE" 2>/dev/null || return 1
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    atual=$(starttime_de "$pid") || return 1
    if [ -n "$st" ] && [ "$st" != "$atual" ]; then
        return 1                    # numero reciclado: nao e mais o nosso
    fi
    tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q udockerd || return 1
    printf '%s' "$pid"
}

# LOCK: duas chamadas `docker ...` ao mesmo tempo subiam DOIS udockerd e o
# pidfile ficava com o que morreu no bind. Quem nao pega o lock espera o outro
# terminar (e normalmente sai no `responde`).
#
# Com `flock` o kernel solta o lock quando o dono morre — nada a adivinhar. Sem
# ele (Termux sem util-linux), mkdir atomico + arquivo "pid starttime":
#   - dono so conta se o pid vive E o starttime bate (PID reciclado apos reboot
#     nao segura o lock);
#   - lock SEM dono (morte entre o mkdir e a gravacao) e velho depois de 60 s;
#   - a limpeza e `mv` atomico para um nome unico e so depois `rm`, conferindo
#     que o movido era mesmo o lock velho visto (senao devolve).
dono_vivo() {   # $1 = "pid starttime"
    local pid st atual
    read -r pid st <<<"$1"
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    atual=$(starttime_de "$pid") || return 1
    [ -z "$st" ] || [ "$st" = "$atual" ]
}

VISTO=""
lock_abandonado() {
    local idade mt
    VISTO=$(cat "$LOCK/dono" 2>/dev/null || true)
    if [ -n "$VISTO" ]; then
        ! dono_vivo "$VISTO"
        return
    fi
    mt=$(stat -c %Y "$LOCK" 2>/dev/null) || return 1    # sumiu: tenta o mkdir
    idade=$(( $(date +%s) - mt ))
    [ "$idade" -gt 60 ]
}

soltar_lock() {
    local meu velho
    meu=$(cat "$LOCK/dono" 2>/dev/null || true)
    [ "${meu%% *}" = "$$" ] || return 0          # nao e mais nosso: nao mexe
    velho="$LOCK.solto.$$"
    mv "$LOCK" "$velho" 2>/dev/null && rm -rf "$velho"
}

pegar_lock() {
    if command -v flock >/dev/null 2>&1; then
        exec 9>>"$LOCKF"
        flock -w "$ESPERA_LOCK" 9 && return 0
        echo "erro: outro docker-daemon-up segura $LOCKF ha ${ESPERA_LOCK} s" >&2
        return 1
    fi
    local fim velho
    fim=$(( $(date +%s) + ESPERA_LOCK ))
    while [ "$(date +%s)" -lt "$fim" ]; do
        if mkdir "$LOCK" 2>/dev/null; then
            printf '%s %s\n' "$$" "$(starttime_de $$ || true)" > "$LOCK/dono.tmp" \
                && mv -f "$LOCK/dono.tmp" "$LOCK/dono"
            trap soltar_lock EXIT
            return 0
        fi
        if lock_abandonado; then
            velho="$LOCK.velho.$$"
            if mv "$LOCK" "$velho" 2>/dev/null; then
                if [ "$(cat "$velho/dono" 2>/dev/null || true)" = "$VISTO" ]; then
                    rm -rf "$velho"
                else
                    # entre a checagem e o mv outro processo limpou e criou um
                    # lock NOVO: devolve (se o lugar ainda estiver vago)
                    [ -e "$LOCK" ] || mv "$velho" "$LOCK" 2>/dev/null || rm -rf "$velho"
                fi
            fi
            continue
        fi
        sleep 0.5
    done
    echo "erro: outro docker-daemon-up segura $LOCK ha ${ESPERA_LOCK} s" >&2
    return 1
}

responde() {
    if [ "$TCP" = 1 ]; then
        curl -s -m 2 "http://127.0.0.1:$PORTA/_ping" 2>/dev/null | grep -q OK
    else
        curl -s -m 2 --unix-socket "$SOCKET" http://localhost/_ping 2>/dev/null | grep -q OK
    fi
}

responde && exit 0

pegar_lock || exit 1
responde && exit 0              # o dono anterior do lock ja subiu o daemon

if [ "$TCP" = 1 ]; then
    [ -x "$UDOCKERD" ] || {
        echo "erro: udockerd nao instalado em $UDOCKERD (rode docker-termux-setup)" >&2
        exit 1
    }
else
    [ -f "$UDOCKERD_UNIX" ] || {
        echo "erro: udockerd-unix ausente em $UDOCKERD_UNIX (rode docker-termux-setup)" >&2
        exit 1
    }
    [ -x "$VENV/bin/python" ] || {
        echo "erro: venv do udockerd ausente em $VENV (rode docker-termux-setup)" >&2
        exit 1
    }
fi

# pid antigo (o MESMO processo, conferido) ainda subindo? espera em vez de duplicar
if antigo=$(pid_do_daemon); then
    for _ in $(seq 1 20); do
        responde && exit 0
        sleep 0.5
    done
    echo "aviso: udockerd $antigo vivo mas sem responder — subindo outro" >&2
fi

# Daemon LEGADO de versao anterior, ainda escutando em TCP? Ele e exatamente o
# problema que o socket resolve (a API do Docker nao autentica e o loopback do
# Android e alcancavel por qualquer app). Nao deixamos o exposto vivo.
if [ "$TCP" != 1 ] && curl -s -m 2 "http://127.0.0.1:$PORTA/_ping" 2>/dev/null | grep -q OK; then
    echo "aviso: daemon antigo escutando em 127.0.0.1:$PORTA (exposto a outros apps) — encerrando" >&2
    python3 - <<'PY' 2>/dev/null || true
import os, signal, time

meu, pai = os.getpid(), os.getppid()
for p in os.listdir('/proc'):
    if not p.isdigit():
        continue
    pid = int(p)
    if pid in (meu, pai):
        continue
    try:
        args = open(f'/proc/{pid}/cmdline', 'rb').read().decode('utf-8', 'replace').split('\0')
    except OSError:
        continue
    # o daemon TCP e `<venv>/bin/udockerd`; o novo e `<venv>/bin/python .../udockerd-unix`
    if args and args[0].rstrip().endswith('/bin/udockerd'):
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
time.sleep(2)
PY
fi

termux-wake-lock 2>/dev/null 9>&- || true

if [ "$TCP" = 1 ]; then
    # 9>&-: o daemon desgarrado nao herda o fd do flock (seguraria o lock
    # enquanto vivesse)
    setsid "$UDOCKERD" --host 127.0.0.1 --port "$PORTA" \
        --data-dir "$HOME/.udocker" "${DNS_ARGS[@]}" \
        >>"$LOG" 2>&1 < /dev/null 9>&- &
else
    setsid "$VENV/bin/python" "$UDOCKERD_UNIX" --socket "$SOCKET" \
        --data-dir "$HOME/.udocker" "${DNS_ARGS[@]}" \
        >>"$LOG" 2>&1 < /dev/null 9>&- &
fi
novo=$!
# grava atomico: "pid starttime"
printf '%s %s\n' "$novo" "$(starttime_de "$novo" || true)" > "$PIDFILE.tmp" \
    && mv -f "$PIDFILE.tmp" "$PIDFILE"

for _ in $(seq 1 30); do
    responde && exit 0
    sleep 0.5
done

echo "erro: daemon nao respondeu em 15s — veja $LOG" >&2
exit 1
