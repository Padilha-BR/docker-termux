#!/data/data/com.termux/files/usr/bin/bash
# docker — no Termux/Android, sem root e sem daemon de kernel.
#
# Duas camadas, escolhidas automaticamente:
#
#  1) PADRAO: CLI oficial do Docker (binario estatico) falando com o daemon
#     udockerd num socket Unix (unix://~/.udockerd/docker.sock, modo 0600), que
#     implementa a API do Docker
#     (run/exec/logs/TTY/build) dirigindo o udocker + proot 5.1.
#     Da tudo que se espera de `docker`: build, exec, logs, comando em
#     container vivo, imagem de outra arquitetura por qemu.
#
#  2) FALLBACK: se o daemon nao subir, cai para o modo direto (udocker + proot
#     na hora, sem daemon) — nao tem build/exec/logs, mas roda containers.
#
# Comandos de diagnostico (doctor, dns-fix, info) sao sempre atendidos pela
# camada direta, que e quem sabe inspecionar o motor.

# TRANSPORTE: socket Unix (modo 0600) em vez de TCP no loopback.
# A API do Docker nao autentica ninguem e, no Android, qualquer app com permissao
# de rede alcanca 127.0.0.1 — pelo TCP, um app de terceiro poderia rodar container
# e montar volume do Termux. O socket Unix so o dono abre (permissao de arquivo).
# DOCKER_DAEMON_TCP=1 volta ao comportamento antigo (tcp://127.0.0.1:2375).
SOCKET="${UDOCKERD_SOCKET:-$HOME/.udockerd/docker.sock}"
if [ "${DOCKER_DAEMON_TCP:-0}" = 1 ]; then
    export DOCKER_HOST="tcp://127.0.0.1:${DOCKER_DAEMON_PORT:-2375}"
else
    export DOCKER_HOST="unix://$SOCKET"
fi

# o daemon responde? (curl: http sobre o socket, ou http direto no modo TCP)
daemon_ok() {
    if [ "${DOCKER_DAEMON_TCP:-0}" = 1 ]; then
        curl -s -m 2 "http://127.0.0.1:${DOCKER_DAEMON_PORT:-2375}/_ping" 2>/dev/null | grep -q OK
    else
        curl -s -m 2 --unix-socket "$SOCKET" "http://localhost/_ping" 2>/dev/null | grep -q OK
    fi
}
export DOCKER_BUILDKIT=0          # o udockerd fala o builder classico, nao BuildKit
# DOCKER_TERMUX_HOME: runtime (CLI oficial, venv, udocker); DOCKER_TERMUX_BIN:
# onde estao os scripts irmaos. Os padroes sao os do Hermes (~/.hermes/bin); sem
# DOCKER_TERMUX_BIN, vale a pasta deste proprio script (roda do clone tambem).
BASE="${DOCKER_TERMUX_HOME:-$HOME/docker-termux}"
MEUBIN="${DOCKER_TERMUX_BIN:-$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")}"
CLI="$BASE/bin/docker"
DIRETO="$MEUBIN/docker-direct"
DAEMON_UP="$MEUBIN/docker-daemon-up"

# --- imagem ausente? puxa pelo motor direto --------------------------------
# O daemon NAO consegue puxar imagem: a lib do udocker detecta a plataforma como
# "android/arm64" e o Docker Hub nao publica essa plataforma
# ("no image found in manifest for platform (android/arm64)"). O modo direto
# puxa com --platform=linux/arm64 e o daemon enxerga a imagem depois (mesmo
# ~/.udocker). Sem isto, `docker run` de imagem nova e `docker build` cujo FROM
# nao esta local falham com mensagem enganosa.
# Flags do `docker run`/`create` que CONSOMEM o proximo token. Fora desta lista,
# uma flag e booleana. Mesma tabela do docker-direct (FLAGS_COM_VALOR la; o
# teste testes/teste-docker-direct.py reprova se as duas divergirem). Faltando
# uma aqui, o valor dela vira a "imagem" e dispara um pull espurio.
flags_com_valor=" -a --attach --add-host --annotation --blkio-weight
--blkio-weight-device --cap-add --cap-drop --cgroup-parent --cgroupns --cidfile
--cpu-count --cpu-percent --cpu-period --cpu-quota --cpu-rt-period --cpu-rt-runtime -c --cpu-shares --cpus
--cpuset-cpus --cpuset-mems --detach-keys --device --device-cgroup-rule
--device-read-bps --device-read-iops --device-write-bps --device-write-iops
--dns --dns-option --dns-search --domainname --entrypoint -e --env --env-file
--expose --gpus --group-add --health-cmd --health-interval --health-retries
--health-start-interval --health-start-period --health-timeout -h --hostname
--io-maxbandwidth --io-maxiops --ip --ip6 --ipc --isolation --kernel-memory
-l --label --label-file --link
--link-local-ip --log-driver --log-opt --mac-address -m --memory
--memory-reservation --memory-swap --memory-swappiness --mount --name --network
--net --network-alias --oom-score-adj --pid --pids-limit --platform -p --publish
--pull --restart --runtime --security-opt --shm-size --stop-signal
--stop-timeout --storage-opt --sysctl --tmpfs --ulimit -u --user --userns --uts -v
--volume --volume-driver --volumes-from -w --workdir "
flags_com_valor="$(printf '%s' "$flags_com_valor" | tr '\n' ' ') "
curtas_com_valor="acehlmpuvw"     # -a -c -e -h -l -m -p -u -v -w

# Le os argumentos de `run`/`create` ATE a imagem (o que vem depois e o comando
# do container: em `docker run alpine date -d @0` o -d nao e do docker).
# Preenche:
#   IMG        a imagem (primeiro token que nao e flag nem valor de flag)
#   TEM_D      1 se ha -d/--detach      TEM_T  1 se ha -t/--tty
#   TEM_BIND   descricao do bind (-v/--volume/--mount), vazio se nao ha
#   PLATAFORMA valor de --platform (nas formas --platform=X e --platform X)
analisar_run() {
    IMG=""; TEM_D=0; TEM_T=0; TEM_BIND=""; PLATAFORMA=""
    local pular="" fim=0 a resto c
    for a in "$@"; do
        if [ -n "$pular" ]; then
            [ "$pular" = "--platform" ] && PLATAFORMA="$a"
            pular=""; continue
        fi
        if [ "$fim" = 1 ]; then IMG="$a"; return 0; fi
        case "$a" in
            --) fim=1 ;;
            --detach|--detach=[tT1]*) TEM_D=1 ;;
            --tty|--tty=[tT1]*)       TEM_T=1 ;;
            --volume|--mount)         TEM_BIND="bind ($a)"; pular="$a" ;;
            --volume=*|--mount=*)     TEM_BIND="bind (${a%%=*})" ;;
            --platform=*)             PLATAFORMA="${a#*=}" ;;
            --*=*) ;;
            --*) case "$flags_com_valor" in *" $a "*) pular="$a" ;; esac ;;
            -?*)
                # cluster curto: -d, -dit, -it, -e X, -eX=1, -v/a:/b ...
                # uma letra que leva valor encerra o cluster (o resto e o valor)
                resto="${a#-}"
                while [ -n "$resto" ]; do
                    c="${resto:0:1}"; resto="${resto:1}"
                    case "$c" in d) TEM_D=1 ;; t) TEM_T=1 ;; esac
                    case "$curtas_com_valor" in
                        *"$c"*)
                            [ "$c" = v ] && TEM_BIND="bind (-v)"
                            [ -z "$resto" ] && pular="-$c"
                            break ;;
                    esac
                done
                ;;
            *) IMG="$a"; return 0 ;;
        esac
    done
    return 0
}

tem_imagem() { "$CLI" image inspect "$1" >/dev/null 2>&1; }
tem_container() { "$CLI" container inspect "$1" >/dev/null 2>&1; }

garantir_imagem() {
    local img="$1"
    [ -z "$img" ] && return 0
    tem_imagem "$img" && return 0
    tem_container "$img" && return 0        # e um container existente, nao imagem
    echo "aviso: imagem '$img' ausente — puxando pelo motor direto (o daemon nao resolve android/arm64)" >&2
    "$DIRETO" pull "$img" >&2 || return 1
    tem_imagem "$img"
}

from_do_dockerfile() {   # le o contexto e imprime as imagens base do FROM
    # flags de `docker build` que consomem o proximo token: sem a lista,
    # `build . -t tag` tomava `tag` como contexto
    local com_valor=" -f --file -t --tag --build-arg --label --target --platform
        --network --add-host --cache-from --iidfile --isolation --cpu-period
        --cpu-quota -c --cpu-shares --cpuset-cpus --cpuset-mems -m --memory
        --memory-swap --shm-size --ulimit --progress --secret --ssh -o --output
        --cgroup-parent --security-opt "
    com_valor="$(printf '%s' "$com_valor" | tr -s ' \n' '  ') "
    local ctx="" arq="" a pular="" nome
    local -A valores=() estagios=()
    for a in "$@"; do
        if [ -n "$pular" ]; then
            case "$pular" in
                -f|--file) arq="$a" ;;
                --build-arg)
                    nome="${a%%=*}"
                    if [[ "$a" == *=* ]]; then valores[$nome]="${a#*=}"
                    elif [ -n "${!nome+x}" ]; then valores[$nome]="${!nome}"; fi ;;
            esac
            pular=""; continue
        fi
        case "$a" in
            --file=*) arq="${a#*=}" ;;
            --build-arg=*)
                a="${a#*=}"; nome="${a%%=*}"
                [[ "$a" == *=* ]] && valores[$nome]="${a#*=}" ;;
            --*=*) ;;
            -*) case "$com_valor" in *" $a "*) pular="$a" ;; esac ;;
            *) [ -z "$ctx" ] && ctx="$a" ;;
        esac
    done
    [ -z "$ctx" ] && ctx="."
    [ -z "$arq" ] && arq="$ctx/Dockerfile"
    [ -f "$arq" ] || return 0
    # ARG antes do 1o FROM da o default (--build-arg vence); FROM pode ter
    # --platform=... antes da imagem e `AS estagio` depois. FROM <estagio>
    # aponta para um estagio anterior, nao para o Hub.
    local tipo x y img k
    while read -r tipo x y; do
        case "$tipo" in
            ARG)
                nome="${x%%=*}"
                if [[ "$x" == *=* ]] && [ -z "${valores[$nome]+x}" ]; then
                    valores[$nome]="${x#*=}"
                fi ;;
            FROM)
                img="$x"
                # do nome mais LONGO para o mais curto: com ARG VERSAO e
                # VERSAO_BASE, trocar $VERSAO primeiro estragava $VERSAO_BASE
                while read -r k; do
                    [ -z "$k" ] && continue
                    img="${img//\$\{$k\}/${valores[$k]}}"
                    img="${img//\$$k/${valores[$k]}}"
                done < <(for k in "${!valores[@]}"; do
                             printf '%d %s\n' "${#k}" "$k"
                         done | sort -rn | cut -d' ' -f2-)
                if [ -n "${estagios[$img]+x}" ]; then
                    :
                elif [[ "$img" == *'$'* ]]; then
                    echo "aviso: FROM $x depende de ARG sem valor — base nao pre-puxada" >&2
                else
                    printf '%s\n' "$img"
                fi
                [ -n "$y" ] && estagios[$y]=1 ;;
        esac
    done < <(awk '
        { sub(/\r$/, "") }                   # Dockerfile com CRLF
        /^[[:space:]]*#/ { next }
        { c = toupper($1) }
        c == "ARG" && !from { print "ARG", $2; next }
        c == "FROM" {
            from = 1; i = 2
            while ($i ~ /^--/) i++
            alias = (toupper($(i + 1)) == "AS") ? $(i + 2) : ""
            print "FROM", $i, alias
        }' "$arq")
}

case "${1:-}" in
    doctor)
        "$DIRETO" doctor || true
        echo
        echo "=== daemon (API do Docker em userspace) ==="
        if daemon_ok; then
            echo "  [OK  ] udockerd respondendo em $DOCKER_HOST"
            "$CLI" version --format '  CLI {{.Client.Version}} | daemon {{.Server.Version}}' 2>/dev/null
        else
            echo "  [    ] parado — sobe sozinho no proximo docker run/pull"
        fi
        echo
        echo "=== o que esta rodando agora ==="
        "$CLI" ps --format '  {{.Names}}  {{.Status}}' 2>/dev/null || true
        exit 0
        ;;
    dns-fix|info)
        exec "$DIRETO" "$@"
        ;;
    daemon)
        case "${2:-status}" in
            up)     bash "$DAEMON_UP" && echo "daemon no ar em $DOCKER_HOST" ;;
            down)   bash "$MEUBIN/docker-daemon-down" ;;
            *)      daemon_ok \
                        && echo "daemon no ar em $DOCKER_HOST" \
                        || echo "daemon parado" ;;
        esac
        exit 0
        ;;
esac

if ! bash "$DAEMON_UP" >/dev/null 2>&1; then
    echo "aviso: daemon indisponivel — usando modo direto (sem build; exec/logs so de container -d do modo direto)" >&2
    exec "$DIRETO" "$@"
fi

# O supervisor (binario C em ~/.udockerd) evita processos orfaos quando o daemon
# sai; se faltar (cache limpo, upgrade), compila aqui.
if ! ls "$HOME"/.udockerd/udockerd-supervisor-* >/dev/null 2>&1; then
    "$BASE/venv-udockerd/bin/python" -c \
        "from udockerd.supervisor import ensure_supervisor; ensure_supervisor()" \
        >/dev/null 2>&1 || true
fi

# --- garante a imagem antes de rodar, criar ou construir -------------------
case "${1:-}" in
    pull)
        # o daemon nao puxa (plataforma android/arm64); o motor direto puxa.
        exec "$DIRETO" "$@"
        ;;
    run|create)
        # Dois casos que o daemon nao atende bem, roteados para o motor direto:
        #  a) -v/--mount: o udockerd ignora HostConfig.Binds (a string "Binds" nao
        #     existe no codigo dele) — o bind seria descartado em silencio;
        #  b) --platform de OUTRA arquitetura: o bind -v /linkerconfig (que
        #     silencia o aviso do linker do Android no qemu) depende de bind, e o
        #     daemon nao faz binds.
        analisar_run "${@:2}"
        precisa_direto="$TEM_BIND"
        if [ -n "$PLATAFORMA" ]; then
            case "$PLATAFORMA" in
                *arm64*|*aarch64*) ;;
                *) precisa_direto="cross-arch (--platform $PLATAFORMA)" ;;
            esac
        fi
        if [ -n "$precisa_direto" ]; then
            echo "aviso: $precisa_direto exige o motor direto; usando modo direto" >&2
            exec "$DIRETO" "$@"
        fi
        # Daqui em diante vai para o DAEMON. Ele so captura o stdout do container
        # quando ha TTY. Verificado com a CLI direta variando SO o -t:
        #   docker run -d   -> `docker logs` vazio (a saida vai para o log do daemon)
        #   docker run -dt  -> `docker logs` devolve a saida
        # O Docker real nao precisa disso, entao em `run -d` sem -t inserimos -t
        # e avisamos. So aqui, depois do roteamento: antes o -t era inserido
        # tambem no `run -d -v ...`, que vai para o motor direto e repassava -t
        # ao udocker sem terminal. So as flags ANTES da imagem contam (o
        # `date -d @0` do comando do container nao e -d) — ver analisar_run.
        if [ "$1" = run ] && [ "$TEM_D" = 1 ] && [ "$TEM_T" = 0 ]; then
            novos=("run" "-t")
            for a in "${@:2}"; do novos+=("$a"); done
            set -- "${novos[@]}"
            echo "dica: -t adicionado para o daemon capturar a saida (sem ele \`docker logs\` volta vazio; limitacao do daemon userspace)" >&2
        fi
        img="$IMG"
        garantir_imagem "$img" || true
        ;;
    build)
        while read -r base; do
            [ -z "$base" ] && continue
            case "$base" in scratch) continue ;; esac
            garantir_imagem "$base" || true
        done < <(from_do_dockerfile "${@:2}")
        ;;
esac

# --- comandos que SO o udocker tem -----------------------------------------
# A API do Docker nao conhece verify/protect/unprotect/mkrepo/setup/name/rmname/
# clone. Roteando para o udocker, um comando so ('docker') cobre as DUAS
# interfaces — e o motor e o mesmo (~/.udocker), entao o estado e compartilhado.
case "${1:-}" in
    verify|protect|unprotect|mkrepo|setup|name|rmname|clone)
        UD_OFICIAL="${UDOCKER_BIN:-${PREFIX:-/data/data/com.termux/files/usr}/bin/udocker}"
        [ -x "$UD_OFICIAL" ] || UD_OFICIAL="$BASE/udocker-${UDOCKER_VERSAO:-1.3.17}/udocker/udocker"
        if [ ! -x "$UD_OFICIAL" ]; then
            echo "erro: udocker nao encontrado (instale com: pkg install udocker)" >&2
            exit 2
        fi
        echo "nota: '$1' e comando nativo do udocker (nao existe na API do Docker) — repassando" >&2
        exec "$UD_OFICIAL" "$@"
        ;;
esac

exec "$CLI" "$@"
