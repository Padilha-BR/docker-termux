#!/data/data/com.termux/files/usr/bin/bash
# docker — no Termux/Android, sem root e sem daemon de kernel.
#
# Duas camadas, escolhidas automaticamente:
#
#  1) PADRAO: CLI oficial do Docker (binario estatico) falando com o daemon
#     udockerd num socket Unix (unix://~/.udockerd/docker.sock, modo 0600), que
#     implementa a API do Docker
#     (run/exec/logs/TTY/build) dirigindo o udocker + proot 5.1.
#     Da tudo que se espera de `docker`: build, exec, logs, comando em
#     container vivo, imagem de outra arquitetura por qemu.
#
#  2) FALLBACK: se o daemon nao subir, cai para o modo direto (udocker + proot
#     na hora, sem daemon) — nao tem build/exec/logs, mas roda containers.
#
# Comandos de diagnostico (doctor, dns-fix, info) sao sempre atendidos pela
# camada direta, que e quem sabe inspecionar o motor.

# TRANSPORTE: socket Unix (modo 0600) em vez de TCP no loopback.
# A API do Docker nao autentica ninguem e, no Android, qualquer app com permissao
# de rede alcanca 127.0.0.1 — pelo TCP, um app de terceiro poderia rodar container
# e montar volume do Termux. O socket Unix so o dono abre (permissao de arquivo).
# DOCKER_DAEMON_TCP=1 volta ao comportamento antigo (tcp://127.0.0.1:2375).
SOCKET="${UDOCKERD_SOCKET:-$HOME/.udockerd/docker.sock}"
if [ "${DOCKER_DAEMON_TCP:-0}" = 1 ]; then
    export DOCKER_HOST="tcp://127.0.0.1:${DOCKER_DAEMON_PORT:-2375}"
else
    export DOCKER_HOST="unix://$SOCKET"
fi

# o daemon responde? (curl: http sobre o socket, ou http direto no modo TCP)
daemon_ok() {
    if [ "${DOCKER_DAEMON_TCP:-0}" = 1 ]; then
        curl -s -m 2 "http://127.0.0.1:${DOCKER_DAEMON_PORT:-2375}/_ping" 2>/dev/null | grep -q OK
    else
        curl -s -m 2 --unix-socket "$SOCKET" "http://localhost/_ping" 2>/dev/null | grep -q OK
    fi
}
export DOCKER_BUILDKIT=0          # o udockerd fala o builder classico, nao BuildKit
CLI="$HOME/docker-termux/bin/docker"
DIRETO="$HOME/.hermes/bin/docker-direct"
DAEMON_UP="$HOME/.hermes/bin/docker-daemon-up"

# --- imagem ausente? puxa pelo motor direto --------------------------------
# O daemon NAO consegue puxar imagem: a lib do udocker detecta a plataforma como
# "android/arm64" e o Docker Hub nao publica essa plataforma
# ("no image found in manifest for platform (android/arm64)"). O modo direto
# puxa com --platform=linux/arm64 e o daemon enxerga a imagem depois (mesmo
# ~/.udocker). Sem isto, `docker run` de imagem nova e `docker build` cujo FROM
# nao esta local falham com mensagem enganosa.
flags_com_valor="-v --volume -e --env -p --publish -w --workdir -u --user \
--name --entrypoint --dns --platform --network --label --mount --add-host \
-m --memory -c --cpus --pid --ipc --ulimit --device --env-file --pull"

achar_imagem() {   # imprime o primeiro argumento que nao e flag nem valor de flag
    local pular=0 a
    for a in "$@"; do
        if [ "$pular" = 1 ]; then pular=0; continue; fi
        case "$a" in
            --*=*|-*=|--*" "*) continue ;;
        esac
        local v
        for v in $flags_com_valor; do
            [ "$a" = "$v" ] && { pular=1; continue 2; }
        done
        case "$a" in
            -*) continue ;;             # flag simples
            *)  printf '%s' "$a"; return 0 ;;
        esac
    done
    return 1
}

tem_imagem() { "$CLI" image inspect "$1" >/dev/null 2>&1; }
tem_container() { "$CLI" container inspect "$1" >/dev/null 2>&1; }

garantir_imagem() {
    local img="$1"
    [ -z "$img" ] && return 0
    tem_imagem "$img" && return 0
    tem_container "$img" && return 0        # e um container existente, nao imagem
    echo "aviso: imagem '$img' ausente — puxando pelo motor direto (o daemon nao resolve android/arm64)" >&2
    "$DIRETO" pull "$img" >&2 || return 1
    tem_imagem "$img"
}

from_do_dockerfile() {   # le o contexto e imprime as imagens base do FROM
    local ctx="." arq="" a pular=0 ultimo=""
    for a in "$@"; do
        if [ "$pular" = 1 ]; then arq="$a"; pular=0; continue; fi
        case "$a" in
            -f|--file) pular=1 ;;
            # -*) cobre --x=y, --flag e -f: listar os especificos antes seria
            # redundante (o shellcheck acusa SC2221/SC2222 e nao muda nada).
            -*) continue ;;
            *) ultimo="$a" ;;
        esac
    done
    [ -n "$ultimo" ] && ctx="$ultimo"
    [ -z "$arq" ] && arq="$ctx/Dockerfile"
    [ -f "$arq" ] || return 0
    awk 'tolower($1)=="from" {print $2}' "$arq" | grep -v '^$'
}

case "${1:-}" in
    doctor)
        "$DIRETO" doctor || true
        echo
        echo "=== daemon (API do Docker em userspace) ==="
        if daemon_ok; then
            echo "  [OK  ] udockerd respondendo em $DOCKER_HOST"
            "$CLI" version --format '  CLI {{.Client.Version}} | daemon {{.Server.Version}}' 2>/dev/null
        else
            echo "  [    ] parado — sobe sozinho no proximo docker run/pull"
        fi
        echo
        echo "=== o que esta rodando agora ==="
        "$CLI" ps --format '  {{.Names}}  {{.Status}}' 2>/dev/null || true
        exit 0
        ;;
    dns-fix|info)
        exec "$DIRETO" "$@"
        ;;
    daemon)
        case "${2:-status}" in
            up)     bash "$DAEMON_UP" && echo "daemon no ar em $DOCKER_HOST" ;;
            down)   bash "$HOME/.hermes/bin/docker-daemon-down" ;;
            *)      daemon_ok \
                        && echo "daemon no ar em $DOCKER_HOST" \
                        || echo "daemon parado" ;;
        esac
        exit 0
        ;;
esac

if ! bash "$DAEMON_UP" >/dev/null 2>&1; then
    echo "aviso: daemon indisponivel — usando modo direto (sem build/exec/logs)" >&2
    exec "$DIRETO" "$@"
fi

# O daemon so captura o stdout do container quando ele tem TTY. Verificado com
# a CLI direta variando SO o -t (supervisor ja compilado):
#   docker run -d   -> `docker logs` vazio (a saida vai para o log do daemon)
#   docker run -dt  -> `docker logs` devolve a saida
# O Docker real nao precisa disso, entao em `run -d` sem -t inserimos -t e
# avisamos, para `docker logs` funcionar como o usuario espera.
if [ "${1:-}" = "run" ]; then
    tem_d=0; tem_t=0
    for a in "$@"; do
        case "$a" in
            --detach) tem_d=1 ;;
            --tty)    tem_t=1 ;;
            -*) # flags curtas agrupadas: -d, -dt, -dit, -it ...
                case "$a" in -*d*) tem_d=1 ;; esac
                case "$a" in --*) ;; *t*) tem_t=1 ;; esac
                ;;
        esac
    done
    if [ "$tem_d" = 1 ] && [ "$tem_t" = 0 ]; then
        novos=("run" "-t")
        for a in "${@:2}"; do novos+=("$a"); done
        set -- "${novos[@]}"
        echo "dica: -t adicionado para o daemon capturar a saida (sem ele \`docker logs\` volta vazio; limitacao do daemon userspace)" >&2
    fi
fi

# O supervisor (binario C em ~/.udockerd) evita processos orfaos quando o daemon
# sai; se faltar (cache limpo, upgrade), compila aqui.
if ! ls "$HOME"/.udockerd/udockerd-supervisor-* >/dev/null 2>&1; then
    "$HOME/docker-termux/venv-udockerd/bin/python" -c \
        "from udockerd.supervisor import ensure_supervisor; ensure_supervisor()" \
        >/dev/null 2>&1 || true
fi

# --- garante a imagem antes de rodar, criar ou construir -------------------
case "${1:-}" in
    pull)
        # o daemon nao puxa (plataforma android/arm64); o motor direto puxa.
        exec "$DIRETO" "$@"
        ;;
    run|create)
        # Dois casos que o daemon nao atende bem, roteados para o motor direto:
        #  a) -v/--mount: o udockerd ignora HostConfig.Binds (a string "Binds" nao
        #     existe no codigo dele) — o bind seria descartado em silencio;
        #  b) --platform de OUTRA arquitetura: o bind -v /linkerconfig (que
        #     silencia o aviso do linker do Android no qemu) depende de bind, e o
        #     daemon nao faz binds.
        precisa_direto=""
        for a in "${@:2}"; do
            case "$a" in
                -v|--volume|--mount) precisa_direto="bind (-v)" ;;
                --platform=*)
                    case "$a" in
                        *arm64|*aarch64) ;;
                        *) precisa_direto="cross-arch ($a)" ;;
                    esac ;;
                --*) ;;
                -*) case "$a" in *v*) precisa_direto="bind (-v)" ;; esac ;;
            esac
        done
        if [ -n "$precisa_direto" ]; then
            echo "aviso: $precisa_direto exige o motor direto; usando modo direto" >&2
            exec "$DIRETO" "$@"
        fi
        img=$(achar_imagem "${@:2}" || true)
        garantir_imagem "$img" || true
        ;;
    build)
        while read -r base; do
            [ -z "$base" ] && continue
            case "$base" in scratch) continue ;; esac
            garantir_imagem "$base" || true
        done < <(from_do_dockerfile "${@:2}")
        ;;
esac

# --- comandos que SO o udocker tem -----------------------------------------
# A API do Docker nao conhece verify/protect/unprotect/mkrepo/setup/name/rmname/
# clone. Roteando para o udocker, um comando so ('docker') cobre as DUAS
# interfaces — e o motor e o mesmo (~/.udocker), entao o estado e compartilhado.
case "${1:-}" in
    verify|protect|unprotect|mkrepo|setup|name|rmname|clone)
        UD_OFICIAL="${UDOCKER_BIN:-$PREFIX/bin/udocker}"
        [ -x "$UD_OFICIAL" ] || UD_OFICIAL="$HOME/docker-termux/udocker-1.3.17/udocker/udocker"
        if [ ! -x "$UD_OFICIAL" ]; then
            echo "erro: udocker nao encontrado (instale com: pkg install udocker)" >&2
            exit 2
        fi
        echo "nota: '$1' e comando nativo do udocker (nao existe na API do Docker) — repassando" >&2
        exec "$UD_OFICIAL" "$@"
        ;;
esac

exec "$CLI" "$@"
