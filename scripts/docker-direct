#!/data/data/com.termux/files/usr/bin/python3
# -*- coding: utf-8 -*-
"""
docker — CLI compativel com Docker para Termux/Android (sem root, sem daemon).

Motor: udocker (registry do Docker Hub, camadas OCI, rootfs)
Execucao: proot 5.1 do Termux (userspace, sem namespaces de kernel)

Quatro bugs do Android/ndk resolvidos aqui (todos medidos, nao supostos):
 1. O proot 4.8.0 que o udocker baixa nao rastreia processos filhos no
    Android 16 -> qualquer fork+exec morre com SIGSYS (signal 31). Curado
    com um shim que aponta o udocker para o proot 5.1 do Termux.
 2. Android nega hardlink dentro do rootfs -> `apk add`/`apt-get` quebram
    com "failed to write database: Permission denied". Curado com
    --link2symlink no shim.
 3. Android nao tem /etc/resolv.conf -> container sobe sem DNS ("bad
    address"). Curado injetando resolv.conf no rootfs de cada container.
 4. Imagem amd64 exige qemu, e o udocker passava so o nome do binario, que
    o proot nao acha no PATH do container. Curado com patch que passa o
    caminho absoluto (+ pacote qemu-user-x86-64).

Uso: docker <comando> [opcoes]   (docker help para a lista)
"""

import glob
import ipaddress
import json
import os
import re
import secrets
import shutil
import signal
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
PREFIX = os.environ.get("PREFIX", "/data/data/com.termux/files/usr")
# DOCKER_TERMUX_HOME: onde o docker-termux-setup instalou o runtime
BASE = os.environ.get("DOCKER_TERMUX_HOME") or os.path.join(HOME, "docker-termux")
VERSAO_UDOCKER_PADRAO = "1.3.17"


def versao_udocker():
    """Versao do udocker em uso: UMA fonte para o setup e para o motor.

    Ordem: UDOCKER_VERSAO (a mesma variavel do setup) > o arquivo que o setup
    grava ao instalar > o padrao. Antes o motor tinha 1.3.17 fixo e o setup
    aceitava outra versao — os dois divergiam em silencio.
    """
    v = os.environ.get("UDOCKER_VERSAO")
    if v:
        return v
    try:
        with open(os.path.join(BASE, "udocker-versao")) as f:
            v = f.read().strip()
    except OSError:
        v = ""
    return v if re.fullmatch(r"[0-9][0-9A-Za-z.+-]*", v or "") else VERSAO_UDOCKER_PADRAO


VERSAO_UDOCKER = versao_udocker()
UDOCKER = os.path.join(BASE, "udocker-" + VERSAO_UDOCKER, "udocker", "udocker")
REPO = os.path.join(HOME, ".udocker")
CONTAINERS = os.path.join(REPO, "containers")
LOGDIR = os.path.join(BASE, "logs")
STATEDIR = os.path.join(BASE, "state")

PLATAFORMA_PADRAO = "linux/arm64"
DNS_PADRAO = "8.8.8.8,8.8.4.4"


def dns_configurado(valor=None):
    """Nameservers do resolv.conf dos containers (DOCKER_TERMUX_DNS).

    8.8.8.8 fixo ignorava VPN/DNS privado. Aceita lista separada por virgula
    ou espaco; so IP valido entra (o valor vai para um arquivo do container,
    entao lixo ou quebra de linha nao passam).
    """
    if valor is None:
        valor = os.environ.get("DOCKER_TERMUX_DNS") or DNS_PADRAO
    nomes = []
    for item in re.split(r"[,\s]+", valor.strip()):
        if not item:
            continue
        try:
            nomes.append(str(ipaddress.ip_address(item)))
        except ValueError:
            print("Aviso: DOCKER_TERMUX_DNS: %r nao e IP — ignorado" % item,
                  file=sys.stderr)
    return nomes or DNS_PADRAO.split(",")


NOMES_DNS = dns_configurado()
# nome de container aceito pelo Docker; o mesmo filtro protege o nome do
# arquivo de log (`--name=../x` escapava de ~/docker-termux/logs)
NOME_VALIDO = re.compile(r"[a-zA-Z0-9][a-zA-Z0-9_.-]*")

VERDE, VERM, AMAR, AZUL, FIM = "\033[32m", "\033[31m", "\033[33m", "\033[36m", "\033[0m"


def cor(txt, c):
    return txt if not sys.stdout.isatty() else c + txt + FIM


def err(msg):
    print(cor("Erro: ", VERM) + msg, file=sys.stderr)


def aviso(msg):
    print(cor("Aviso: ", AMAR) + msg, file=sys.stderr)


def info(msg):
    print(cor("==> ", AZUL) + msg)


def ambiente():
    """Ambiente saneado para o udocker/proot.

    - LD_PRELOAD: o termux-exec injeta libs do Termux que nao existem no
      rootfs do container; vazar isso mata o processo com SIGSYS.
    - PROOT_NO_SECCOMP: o seccomp do Android conflita com o do proot.
    - TMPDIR: sem ele o udocker tenta /tmp, que nao existe no Android.
    """
    env = dict(os.environ)
    env.pop("LD_PRELOAD", None)
    env.pop("LD_LIBRARY_PATH", None)
    env["PROOT_NO_SECCOMP"] = "1"
    env["TMPDIR"] = env.get("TMPDIR") or os.path.join(PREFIX, "tmp")
    env["PATH"] = os.path.join(PREFIX, "bin") + ":" + env.get("PATH", "")
    env["LANG"] = env.get("LANG") or "C.UTF-8"
    return env


def udocker(args, capturar=False, silencioso=False):
    if not os.path.exists(UDOCKER):
        err("runtime nao instalado em %s — rode: docker-termux-setup" % UDOCKER)
        sys.exit(2)
    cmd = [UDOCKER] + ["--quiet"] * silencioso + args
    if capturar:
        return subprocess.run(cmd, env=ambiente(), stdout=subprocess.PIPE,
                              stderr=subprocess.STDOUT, text=True)
    return subprocess.call(cmd, env=ambiente())


def containers_locais():
    """Mapa nome -> caminho, uma entrada por container.

    O udocker materializa `create --name=X` como um SYMLINK X -> <uuid>.
    Sem tratar isso o `ps` lista o mesmo container duas vezes; aqui a chave
    passa a ser o nome amigavel quando ele existe.
    """
    achados = {}
    if not os.path.isdir(CONTAINERS):
        return achados
    reais, apelidos = {}, {}
    for nome in sorted(os.listdir(CONTAINERS)):
        caminho = os.path.join(CONTAINERS, nome)
        if os.path.islink(caminho):
            alvo = os.path.basename(os.path.realpath(caminho))
            apelidos.setdefault(alvo, []).append(nome)
        elif os.path.isfile(os.path.join(caminho, "container.json")):
            reais[nome] = caminho
    for cid, caminho in reais.items():
        nomes = apelidos.get(cid, [])
        achados[nomes[0] if nomes else cid] = caminho
    return achados


def resolve_container(nome, prefixo=True):
    """Caminho real do container `nome` (nome, id ou prefixo unico).

    prefixo=False exige o nome exato: o reuso implicito do `run` nao pode
    pegar `python-web` quando o usuario escreveu `docker run python`.
    """
    if not nome or "/" in nome or nome in (".", ".."):
        return None
    direto = os.path.join(CONTAINERS, nome)
    if os.path.exists(direto):
        return os.path.realpath(direto)
    if not prefixo:
        return None
    achados = {k: v for k, v in containers_locais().items()
               if k == nome or k.startswith(nome)}
    if len(achados) > 1:
        # prefixo ambiguo: operar no container errado e pior que falhar
        err("prefixo %r ambiguo entre: %s — use o nome completo"
            % (nome, ", ".join(sorted(achados))))
        sys.exit(2)
    if achados:
        return os.path.realpath(next(iter(achados.values())))
    return None


def nomes_do_container(caminho):
    """Todos os nomes pelos quais um container e conhecido: o id e os apelidos.

    O state do `run -d` e gravado pelo nome usado na hora (apelido ou id);
    `rm`/`stop` precisam achar esse state seja qual for o nome digitado agora.
    """
    real = os.path.realpath(caminho)
    nomes = {os.path.basename(real)}
    if os.path.isdir(CONTAINERS):
        for nome in os.listdir(CONTAINERS):
            c = os.path.join(CONTAINERS, nome)
            if os.path.islink(c) and os.path.realpath(c) == real:
                nomes.add(nome)
    return nomes


def imagem_local(img):
    """True se a imagem ja foi puxada.

    Layout do repo do udocker: ~/.udocker/repos/<repo>/<tag>, onde <repo> e
    o nome apos a barra para imagens com namespace (ex: grafana/grafana ->
    repos/grafana/grafana/latest).
    """
    repos = os.path.join(REPO, "repos")
    base = img.split("@", 1)[0]                 # digest nao e tag
    if ":" in base.rsplit("/", 1)[-1]:
        # so o ':' apos o ultimo '/' separa tag: host:5000/repo nao e tag
        nome, _, tag = base.rpartition(":")
    else:
        nome, tag = base, "latest"
    return os.path.isdir(os.path.join(repos, nome, tag))


def fix_dns(nome_ou_caminho):
    """Injeta resolv.conf no rootfs: no Android nao existe /etc/resolv.conf.

    O rootfs vem de uma imagem qualquer, entao nada nele e confiavel:
      - ROOT/etc pode ser symlink para fora do rootfs: realpath + commonpath
        recusam (antes a escrita escapava para o host);
      - etc/resolv.conf pode ser symlink (o ubuntu/debian com systemd-resolved
        traz um para ../run/...): o LINK e removido — nunca o alvo — e o
        arquivo e criado no lugar (antes o O_NOFOLLOW so falhava e o container
        ficava sem DNS em silencio);
      - O_NOFOLLOW continua na escrita, contra a troca entre o unlink e o open.
    """
    caminho = resolve_container(nome_ou_caminho) if not os.path.isabs(nome_ou_caminho or "") else nome_ou_caminho
    if not caminho:
        return False
    raiz = os.path.realpath(os.path.join(caminho, "ROOT"))
    etc = os.path.realpath(os.path.join(raiz, "etc"))
    if os.path.commonpath([raiz, etc]) != raiz:
        aviso("%s: ROOT/etc aponta para fora do rootfs (%s) — resolv.conf NAO "
              "escrito" % (os.path.basename(caminho), etc))
        return False
    if not os.path.isdir(etc):
        return False
    destino = os.path.join(etc, "resolv.conf")
    try:
        if os.path.islink(destino):
            os.unlink(destino)
        # O_NOFOLLOW: uma imagem pode plantar symlink aqui e desviar a escrita
        # para fora do ROOT do container
        flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        fd = os.open(destino, flags, 0o644)
        with os.fdopen(fd, "w") as f:
            f.write("".join("nameserver %s\n" % n for n in NOMES_DNS))
        return True
    except OSError:
        return False


def fix_dns_todos():
    n = 0
    for _, caminho in containers_locais().items():
        if fix_dns(caminho):
            n += 1
    return n


def arquitetura_host():
    import platform as _p
    m = _p.machine()
    return "arm64" if m in ("aarch64", "arm64") else "amd64"


def precisa_qemu(caminho_container):
    """True se a imagem do container e de outra arquitetura (roda via qemu)."""
    try:
        with open(os.path.join(caminho_container, "container.json")) as f:
            arq = json.load(f).get("architecture", "")
    except (OSError, ValueError):
        return False
    arq = "arm64" if arq in ("arm64", "aarch64") else arq
    return bool(arq) and arq != arquitetura_host()


def split_nome_tag(img):
    if ":" in img.split("/")[-1]:
        return img
    return img + ":latest"


def normalizar_arq(arq):
    """'linux/arm64/v8' | 'aarch64' | 'x86_64' -> 'arm64' | 'amd64' | ..."""
    partes = [p for p in (arq or "").lower().split("/") if p]
    if len(partes) >= 2 and partes[0] in ("linux", "windows", "darwin"):
        arq = partes[1]
    elif partes:
        arq = partes[0]
    return {"aarch64": "arm64", "arm64": "arm64", "x86_64": "amd64",
            "amd64": "amd64", "x86-64": "amd64"}.get(arq, arq)


def arquitetura_imagem(img):
    """Arquitetura da tag local, lida dos metadados do udocker (ou None).

    Layout: repos/<repo>/<tag>/manifest; no schema 2 o config (com
    "architecture") e o arquivo cujo nome e o digest do config.
    """
    base = img.split("@", 1)[0]
    if ":" in base.rsplit("/", 1)[-1]:
        nome, _, tag = base.rpartition(":")
    else:
        nome, tag = base, "latest"
    pasta = os.path.join(REPO, "repos", nome, tag)
    try:
        with open(os.path.join(pasta, "manifest")) as f:
            manifest = json.load(f)
        if "layers" in manifest:
            with open(os.path.join(pasta, manifest["config"]["digest"])) as f:
                cfg = json.load(f)
        else:
            cfg = json.loads(manifest["history"][0]["v1Compatibility"])
        return normalizar_arq(cfg.get("architecture")) or None
    except (OSError, ValueError, KeyError, IndexError, TypeError):
        return None


def garantir_imagem(img, plataforma=None):
    """Puxa a imagem do Docker Hub se ainda nao existir localmente.

    Com --platform, confere tambem a ARQUITETURA da tag local: o udocker
    guarda uma arquitetura por tag, e antes `--platform=linux/amd64` era
    ignorado se a tag ja existisse (uname -m dava aarch64 sem aviso).
    """
    img = split_nome_tag(img)
    if imagem_local(img):
        if not plataforma:
            return True
        quer, tem = normalizar_arq(plataforma), arquitetura_imagem(img)
        if tem is None:
            aviso("--platform=%s: nao deu para conferir a arquitetura da tag "
                  "local %s; se estiver errada, rode `docker pull "
                  "--platform=%s %s`" % (plataforma, img, plataforma, img))
            return True
        if tem == quer:
            return True
        aviso("a tag local %s e %s, mas --platform pede %s: puxando de novo "
              "(o udocker guarda UMA arquitetura por tag; a %s local sera "
              "substituida)" % (img, tem, quer, tem))
    plat = plataforma or plataforma_alvo(img)
    info("puxando %s (%s)" % (img, plat))
    rc = udocker(["pull", "--platform=" + plat, img])
    if rc != 0:
        err("falha ao puxar %s" % img)
        return False
    return True


def plataforma_alvo(img):
    """Imagem multi-arch: usa arm64 nativo; o usuario pode forcar --platform."""
    return PLATAFORMA_PADRAO


def criar_container(img, nome=None):
    args = ["create"]
    if nome:
        args += ["--name=" + nome]
    args.append(img)
    # stdout e stderr SEPARADOS: o udocker imprime o id no stdout e avisos no
    # stderr; misturados, um aviso na ultima linha virava o "id" do container
    r = subprocess.run([UDOCKER] + args, env=ambiente(), stdout=subprocess.PIPE,
                       stderr=subprocess.PIPE, text=True)
    if r.returncode != 0:
        err("falha ao criar container a partir de %s\n%s"
            % (img, (r.stderr + r.stdout).strip()))
        return None
    # a ultima linha do stdout e o id do container
    linhas = [l.strip() for l in r.stdout.splitlines() if l.strip()]
    cid = linhas[-1] if linhas else ""
    if not cid or not os.path.isdir(os.path.join(CONTAINERS, cid)):
        err("udocker criou mas nao devolveu um id valido de %s: %s"
            % (img, (r.stdout + r.stderr).strip() or "(saida vazia)"))
        return None
    return cid


# --------------------------------------------------------------------------
# parsing de opcoes no estilo docker
# --------------------------------------------------------------------------
# Tabela das flags de `docker run`/`create`/`exec` (docker 29). Antes o parser
# adivinhava: `-m 512m` virava booleano e `512m` a imagem; `--rm=true` e
# `--publish-all` comiam a imagem como valor. Fora destas tabelas, a flag e
# recusada — o docker tambem recusa flag desconhecida.
FLAGS_COM_VALOR = {
    "-a", "--attach", "--add-host", "--annotation", "--blkio-weight",
    "--blkio-weight-device", "--cap-add", "--cap-drop", "--cgroup-parent",
    "--cgroupns", "--cidfile", "--cpu-period", "--cpu-quota",
    "--cpu-rt-period", "--cpu-rt-runtime", "-c", "--cpu-shares", "--cpus",
    "--cpuset-cpus", "--cpuset-mems", "--detach-keys", "--device",
    "--device-cgroup-rule", "--device-read-bps", "--device-read-iops",
    "--device-write-bps", "--device-write-iops", "--dns", "--dns-option",
    "--dns-search", "--domainname", "--entrypoint", "-e", "--env",
    "--env-file", "--expose", "--gpus", "--group-add", "--health-cmd",
    "--health-interval", "--health-retries", "--health-start-interval",
    "--health-start-period", "--health-timeout", "-h", "--hostname", "--ip",
    "--ip6", "--ipc", "--isolation", "--kernel-memory", "-l", "--label",
    "--label-file", "--link", "--link-local-ip", "--log-driver", "--log-opt",
    "--mac-address", "-m", "--memory", "--memory-reservation",
    "--memory-swap", "--memory-swappiness", "--mount", "--name", "--network",
    "--net", "--network-alias", "--oom-score-adj", "--pid", "--pids-limit",
    "--platform", "-p", "--publish", "--pull", "--restart", "--runtime",
    "--security-opt", "--shm-size", "--stop-signal", "--stop-timeout",
    "--storage-opt", "--sysctl", "--tmpfs", "-u", "--user", "--userns",
    "--uts", "-v", "--volume", "--volume-driver", "--volumes-from", "-w",
    "--workdir",
}
# compat: nome antigo da tabela
OPTS_COM_VALOR = FLAGS_COM_VALOR

# flags BOOLEANAS: o token seguinte NAO e valor (e o alvo/comando). Aceitam
# tambem a forma --flag=true|false.
FLAGS_SEM_VALOR = {"--rm", "--detach", "--privileged", "--init", "--read-only",
                   "--tty", "--interactive", "--sig-proxy", "--no-healthcheck",
                   "--oom-kill-disable", "--publish-all", "--quiet",
                   "--disable-content-trust", "--use-api-socket"}

CURTAS_SEM_VALOR = set("ditPq")
CURTAS_COM_VALOR = set("acehlmpuvw")

# flags que podem repetir e vao para `multi` (chave canonica)
MULTI = {"-v": "-v", "--volume": "-v", "-e": "-e", "--env": "-e",
         "-p": "-p", "--publish": "-p", "--mount": "--mount"}
# forma longa dos booleanos de uma letra que o resto do codigo consulta
CANONICA = {"--detach": "-d", "--interactive": "-i", "--tty": "-t"}


def _booleano(valor):
    return str(valor).strip().lower() not in ("false", "0", "no", "f", "")


def _guardar(opts, multi, chave, valor):
    if chave in MULTI:
        multi[MULTI[chave]].append(valor)
    else:
        opts[chave] = valor


def parse_exec_style(argv):
    """Separa opcoes, imagem/container e comando (do primeiro nao-opcao em diante)."""
    opts = {}
    multi = {"-v": [], "-e": [], "-p": [], "--mount": []}
    i = 0
    alvo = None
    comando = []
    while i < len(argv):
        a = argv[i]
        if a == "--":
            if alvo is None and i + 1 < len(argv):
                alvo, comando = argv[i + 1], argv[i + 2:]
            else:
                comando = argv[i + 1:]
            break
        if alvo is not None:
            comando = argv[i:]
            break
        if a.startswith("--") and "=" in a:
            # --k=v: antes ia SEMPRE para opts, entao --volume=/a:/b,
            # --env=X=1 e --publish=8080:80 sumiam em silencio
            k, _, v = a.partition("=")
            if k in FLAGS_SEM_VALOR:
                opts[CANONICA.get(k, k)] = _booleano(v)
            elif k in FLAGS_COM_VALOR:
                _guardar(opts, multi, k, v)
            else:
                err("opcao desconhecida: %s" % k)
                sys.exit(2)
        elif a in FLAGS_COM_VALOR:
            if i + 1 >= len(argv):
                err("opcao %s exige um valor" % a)
                sys.exit(2)
            i += 1
            _guardar(opts, multi, a, argv[i])
        elif a in FLAGS_SEM_VALOR:
            opts[CANONICA.get(a, a)] = True
        elif a.startswith("--"):
            err("opcao desconhecida: %s (o docker tambem recusaria)" % a)
            sys.exit(2)
        elif a.startswith("-") and len(a) > 1:
            # flags curtas agrupadas: -it, -dit, -d, -e X, -eX=1 ...
            # uma letra que leva valor encerra o cluster: o resto e o valor
            for pos, ch in enumerate(a[1:], start=2):
                if ch in CURTAS_SEM_VALOR:
                    opts["-" + ch] = True
                elif ch in CURTAS_COM_VALOR:
                    resto = a[pos:]
                    if not resto:
                        if i + 1 >= len(argv):
                            err("opcao -%s exige um valor" % ch)
                            sys.exit(2)
                        i += 1
                        resto = argv[i]
                    _guardar(opts, multi, "-" + ch, resto)
                    break
                else:
                    err("opcao desconhecida: -%s (em %s)" % (ch, a))
                    sys.exit(2)
        else:
            alvo = a
        i += 1
    return opts, multi, alvo, comando


OPCOES_DE_VOLUME = {"ro", "rw", "z", "Z", "shared", "slave", "private",
                    "rshared", "rslave", "rprivate", "nocopy", "consistent",
                    "cached", "delegated"}


def limpar_volume(valor):
    """-v host:ctr[:opcoes] -> host:ctr (+ aviso).

    O udocker NAO entende o 3o campo: `-v a:/b:ro` nao monta nada e cria um
    arquivo-lixo `b:ro` no destino — e o usuario acha que o host esta
    protegido. Aqui o sufixo sai com aviso; em particular, ro NAO e garantido.
    """
    partes = valor.split(":")
    if len(partes) == 3 and partes[2] and set(partes[2].split(",")) <= OPCOES_DE_VOLUME:
        opcoes = partes[2]
        aviso("-v %s: o modo direto nao aplica opcoes de bind (%s) — montado "
              "como %s:%s%s" % (valor, opcoes, partes[0], partes[1],
                                " COM ESCRITA (ro nao e garantido)"
                                if "ro" in opcoes.split(",") else ""))
        return "%s:%s" % (partes[0], partes[1])
    return valor


def montar_mount(valor):
    """--mount type=bind,source=H,target=C -> (H, C). Devolve (par, erro).

    Aceita os sinonimos do docker: source|src, target|destination|dst.
    """
    campos = {}
    for item in valor.split(","):
        if not item:
            continue
        if "=" in item:
            k, _, v = item.partition("=")
            campos[k] = v
        else:
            campos[item] = True     # chave sem valor: readonly, consistent
    if campos.get("type", "bind") != "bind":
        return None, ("--mount type=%s nao existe neste modo (so type=bind)"
                      % campos.get("type", "?"))
    src = campos.get("source") or campos.get("src")
    dst = campos.get("target") or campos.get("destination") or campos.get("dst")
    if not src or not dst or src is True or dst is True:
        return None, "--mount type=bind exige source= e target="
    ro = campos.get("readonly", campos.get("ro"))
    if ro is not None and _booleano(ro if ro is not True else "true"):
        # mesma regra do -v :ro (limpar_volume): monta, mas avisa alto
        aviso("--mount %s: readonly NAO e garantido no modo direto (o udocker "
              "nao faz bind somente-leitura) — montado COM ESCRITA" % valor)
    return (src, dst), None


def opcoes_descartadas(opts):
    """Opcoes que o parser aceitou mas que o udocker NAO recebe."""
    repassadas = {"-v", "--volume", "-e", "--env", "-w", "--workdir", "-u", "--user",
                  "--entrypoint", "--dns", "--platform", "--pull", "--name",
                  "--mount", "--env-file", "--rm", "-i", "-t", "-d", "--detach",
                  "--interactive", "--tty"}
    return sorted(k for k in opts if k not in repassadas)


def montar_flags_udocker(opts, multi, comando):
    args = []
    for v in multi.get("-v", []):
        args += ["-v", limpar_volume(v)]
    for e in multi.get("-e", []):
        args += ["-e", e]
    for w in ("-w", "--workdir"):
        if w in opts:
            args += ["-w", opts[w]]
            break
    for u in ("-u", "--user"):
        if u in opts:
            args += ["-u", opts[u]]
            break
    for ep in ("--entrypoint",):
        if ep in opts:
            args += ["--entrypoint=" + opts[ep]]
    for dn in ("--dns",):
        if dn in opts:
            args += ["--dns=" + opts[dn]]
    if opts.get("-i"):
        args += ["-i"]
    if opts.get("-t"):
        args += ["-t"]
    # --mount: o dispatcher roteia pro modo direto dizendo que monta; sem
    # traduzir aqui, a montagem sumia em silencio (o udocker so conhece -v)
    for valor in multi.get("--mount", []):
        par, erro = montar_mount(valor)
        if erro:
            # montar_mount_ou_erro (cmd_run) ja recusou antes de criar; aqui
            # e defesa para quem chama direto
            aviso(erro + " — montagem NAO aplicada")
        else:
            args += ["-v", "%s:%s" % par]
    if opts.get("--env-file"):
        arq_env = opts["--env-file"]
        try:
            with open(arq_env) as f:
                linhas = [l.strip() for l in f
                          if l.strip() and not l.strip().startswith("#")]
        except OSError as e:
            aviso("--env-file ilegivel (%s): %s — ignorado" % (arq_env, e))
            linhas = []
        for linha in linhas:
            args += ["-e", linha]
    return args


def nome_seguro(nome):
    """Nome de arquivo derivado do nome do container, sem `/` nem `..`."""
    return re.sub(r"[^A-Za-z0-9_.-]", "_", nome).lstrip(".") or "_"


def state_path(nome):
    return os.path.join(STATEDIR, nome_seguro(nome) + ".json")


def log_path(nome):
    return os.path.join(LOGDIR, nome_seguro(nome) + ".log")


def ler_state(nome):
    p = state_path(nome)
    if os.path.exists(p):
        try:
            with open(p) as f:
                return json.load(f)
        except (OSError, ValueError):
            return {}
    return {}


def gravar_state(nome, dados):
    """Grava atomicamente (tmp + replace): um kill no meio nao deixa JSON
    pela metade, que o ler_state trataria como "sem state" e perderia o pid."""
    os.makedirs(STATEDIR, exist_ok=True)
    destino = state_path(nome)
    tmp = "%s.%d.tmp" % (destino, os.getpid())
    with open(tmp, "w") as f:
        json.dump(dados, f, indent=1)
    os.replace(tmp, destino)


def apagar_state(nome, com_log=False):
    st = ler_state(nome)
    for p in [state_path(nome)] + ([st.get("log")] if com_log and st.get("log") else []):
        try:
            os.remove(p)
        except OSError:
            pass


def pid_vivo(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def starttime(pid):
    """Campo 22 do /proc/<pid>/stat — assinatura do processo."""
    try:
        with open("/proc/%d/stat" % int(pid)) as f:
            dados = f.read()
        return dados.rsplit(")", 1)[1].split()[19]
    except (OSError, ValueError, IndexError):
        return None


def mesmo_processo(pid, st):
    """True se o pid ainda e o MESMO processo gravado (nao foi reciclado).

    Sem isto, depois de um reboot do aparelho o `docker stop` mandava SIGKILL
    para um processo inocente que tinha herdado o numero.
    """
    guard = st.get("starttime")
    if not guard:
        return True            # estado antigo: nao da para conferir, nao bloqueia
    atual = starttime(pid)
    return atual is None or atual == guard


def processo_vivo(st):
    """True se o state aponta para um processo vivo e que ainda e o nosso."""
    pid = st.get("pid")
    return bool(pid) and pid_vivo(pid) and mesmo_processo(pid, st)


def sinalizar(pid, sinal):
    """Sinal para o grupo (o proot e o container vao junto); sem grupo, so o pid."""
    try:
        os.killpg(os.getpgid(pid), sinal)
    except (OSError, AttributeError):
        try:
            os.kill(pid, sinal)
        except OSError:
            pass


def encerrar(pid, sinal=signal.SIGTERM, espera=5.0):
    """Manda `sinal`, espera ate `espera` s e termina com SIGKILL."""
    sinalizar(pid, sinal)
    fim = time.time() + espera
    while time.time() < fim:
        if not pid_vivo(pid):
            return
        time.sleep(0.25)
    if pid_vivo(pid):
        sinalizar(pid, getattr(signal, "SIGKILL", signal.SIGTERM))


def remover_container(nome_ou_id):
    """udocker rm + state e log de todos os nomes do container."""
    caminho = resolve_container(nome_ou_id, prefixo=False)
    nomes = nomes_do_container(caminho) if caminho else set()
    nomes.add(nome_ou_id)
    rc = udocker(["rm", os.path.basename(caminho) if caminho else nome_ou_id],
                 silencioso=True)
    if rc == 0:
        for n in nomes:
            apagar_state(n, com_log=True)
    return rc


def limpar_rm_pendentes():
    """`run -d --rm` cujo processo ja saiu: o docker teria removido sozinho.

    Sem monitor residente, a remocao acontece aqui (chamado pelo ps).
    """
    if not os.path.isdir(STATEDIR):
        return
    for arq in sorted(os.listdir(STATEDIR)):
        if not arq.endswith(".json"):
            continue
        nome = arq[:-5]
        st = ler_state(nome)
        if st.get("rm") and not processo_vivo(st):
            remover_container(nome)


# --------------------------------------------------------------------------
# comandos
# --------------------------------------------------------------------------
def cmd_help(argv=None):
    print("""docker (Termux) — Docker sem root e sem daemon, via udocker + proot

  docker pull <imagem>[:tag]        baixa imagem do Docker Hub (--platform=linux/amd64 p/ x86)
  docker images                     lista imagens baixadas
  docker ps [-a]                    containers criados (a = todos, com pid dos -d)
  docker run [opcoes] IMG [cmd]     cria e executa container
  docker create [opcoes] IMG        so cria (nao executa)
  docker exec [-it -e -u -w] <ctr> <cmd>   roda comando em container existente
  docker logs [-f] [-n N] <ctr>     saida de um `run -d`
  docker stop [-t S] <ctr>...       encerra container(s) em background
  docker rm [-f] <ctr>...           remove container(s) (-f: mesmo rodando)
  docker rmi <imagem>               remove imagem
  docker search <termo>             busca no Docker Hub
  docker inspect <ctr|imagem>       metadados
  docker doctor                     diagnostico do motor
  docker dns-fix                    injeta resolv.conf em todos os containers
  docker version | info             versoes e estado

opcoes do run:
  -v host:ctr   monta volume        -e VAR=val    variavel de ambiente
  -w /dir       diretorio inicial   -u uid        usuario
  -it           interativo com tty  -d            roda em background
  --rm          remove ao terminar  --name=<n>    nome do container (novo)
  --mount type=bind,source=H,target=C            --env-file=<arq>
  --entrypoint=<prog>               --platform=linux/amd64  (emulado por qemu)
  (`:ro` e `readonly` NAO sao garantidos: o bind e sempre com escrita)

limitacoes reais (medidas): sem daemon, sem namespaces de kernel, sem
`docker build` (use `docker run` + comandos dentro), rede e a do proprio
Termux (portas nao sao isoladas) e `--memory/--cpus` nao se aplicam.""")


def cmd_version(argv=None):
    print("docker (Termux) 1.0 — udocker + proot userspace")
    udocker(["version"])


def cmd_pull(argv):
    plataforma = None
    resto = []
    i = 0
    while i < len(argv):
        if argv[i].startswith("--platform="):
            plataforma = argv[i].split("=", 1)[1]
        elif argv[i] == "--platform" and i + 1 < len(argv):
            i += 1
            plataforma = argv[i]
        else:
            resto.append(argv[i])
        i += 1
    if not resto:
        err("uso: docker pull <imagem>[:tag]")
        return 2
    plat = plataforma or plataforma_alvo(resto[0])
    if plat != PLATAFORMA_PADRAO:
        aviso("esta tag local passa a ser %s (o repo do udocker guarda UMA "
              "arquitetura por tag); para voltar a nativa, rode o pull sem "
              "--platform" % plat)
    return udocker(["pull", "--platform=" + plat] + resto)


def cmd_images(argv=None):
    return udocker(["images"])


def cmd_ps(argv):
    todos = "-a" in argv or "--all" in argv
    limpar_rm_pendentes()
    # a tabela vem do estado local; a antiga chamada `udocker ps` era descartada
    # (custava ~4s de proot em todo `docker ps` e amarrava o comando ao udocker)
    print(cor("CONTAINER".ljust(38) + "STATUS".ljust(14) + "PID", AZUL))
    achou = False
    for nome in sorted(containers_locais()):
        st = ler_state(nome)
        pid = st.get("pid")
        vivo = bool(pid) and pid_vivo(pid) and mesmo_processo(pid, st)
        # igual ao docker: `ps` so mostra o que roda; `-a` mostra todos
        if not vivo and not todos:
            continue
        if vivo:
            status = "Up (bg)"
        elif pid:
            status = "Parado"
        else:
            status = "Criado"
        print(nome.ljust(38) + status.ljust(14) + (str(pid) if vivo else "-"))
        achou = True
    if not achou:
        print("(nenhum container)" if todos else "(nenhum container rodando em background; use -a)")
    return 0


def cmd_create(argv):
    opts, multi, alvo, _ = parse_exec_style(argv)
    if not alvo:
        err("uso: docker create [opcoes] <imagem>")
        return 2
    descartadas = opcoes_descartadas(opts)
    if descartadas:
        aviso("opcoes ignoradas pelo modo direto: %s" % " ".join(descartadas))
    nome = opts.get("--name")
    rc = conferir_nome_novo(nome)
    if rc:
        return rc
    if not garantir_imagem(alvo, opts.get("--platform")):
        return 1
    cid = criar_container(alvo, nome)
    if not cid:
        return 1
    fix_dns(cid)
    print(cid)
    return 0


def conferir_nome_novo(nome):
    """0 se `nome` pode ser usado num container NOVO; senao o codigo de erro.

    Antes `run --rm --name dev` com `dev` existente REUSAVA o container e
    depois o apagava (perdia o que estava instalado nele). O docker recusa.
    """
    if not nome:
        return 0
    if not NOME_VALIDO.fullmatch(nome):
        err("nome de container invalido: %r (use [a-zA-Z0-9][a-zA-Z0-9_.-]*)" % nome)
        return 125
    if os.path.lexists(os.path.join(CONTAINERS, nome)):
        err("o nome %r ja esta em uso por um container. Remova (`docker rm %s`) "
            "ou escolha outro nome; para rodar nele: `docker exec %s <cmd>`"
            % (nome, nome, nome))
        return 125
    return 0


def _esperar_filho(p):
    """Espera o udocker; Ctrl-C ja chegou ao filho (mesmo grupo do terminal)."""
    try:
        return p.wait()
    except KeyboardInterrupt:
        try:
            return p.wait(timeout=10)
        except (KeyboardInterrupt, subprocess.TimeoutExpired):
            p.kill()
            return p.wait()


def rodar_primeiro_plano(args, ao_terminar=None):
    """Roda o udocker e GARANTE `ao_terminar` (o --rm) mesmo com Ctrl-C/SIGTERM.

    Antes o `rm` vinha depois de um subprocess.call simples: Ctrl-C ou SIGTERM
    (um `timeout`, o agente encerrando) pulavam a remocao e cada container
    deixava um rootfs inteiro para tras. SIGTERM/SIGHUP sao repassados ao filho
    e o rm roda depois que ele sai. SIGKILL nao da para tratar — e o caso que
    ainda pode deixar rootfs (ver `docker ps -a`).
    """
    recebido = []

    def repassa(sinal, _quadro):
        recebido.append(sinal)
        try:
            p.send_signal(sinal)
        except OSError:
            pass

    p = subprocess.Popen([UDOCKER] + args, env=ambiente())
    antigos = {}
    for nome in ("SIGTERM", "SIGHUP"):
        s = getattr(signal, nome, None)
        if s is not None:
            antigos[s] = signal.signal(s, repassa)
    try:
        rc = _esperar_filho(p)
    finally:
        for s, h in antigos.items():
            signal.signal(s, h)
        if ao_terminar:
            ao_terminar()
    if recebido:
        return 128 + recebido[0]
    return 128 - rc if rc < 0 else rc


def cmd_run(argv):
    opts, multi, alvo, comando = parse_exec_style(argv)
    if not alvo:
        err("uso: docker run [opcoes] <imagem|container> [comando]")
        return 2
    descartadas = opcoes_descartadas(opts)
    if descartadas:
        aviso("opcoes ignoradas pelo modo direto: %s" % " ".join(descartadas))
    for valor in multi.get("--mount", []):
        _, erro = montar_mount(valor)
        if erro:
            # o docker recusa --mount invalido; montar "quase" e pior
            err(erro)
            return 2

    if multi.get("-p") or opts.get("-P") or opts.get("--publish-all"):
        aviso("portas nao sao isoladas neste modo: o container usa a rede do "
              "Termux, entao o servico ja escuta direto (ex: 127.0.0.1:8000). "
              "-p ignorado de proposito.")

    detach = bool(opts.get("-d") or opts.get("--detach"))
    remover = bool(opts.get("--rm"))
    nome = opts.get("--name")
    rc = conferir_nome_novo(nome)
    if rc:
        return rc
    ctr = None
    reusando = False
    if not nome and not imagem_local(split_nome_tag(alvo)):
        # so procura container quando o alvo NAO e imagem local: senao um
        # container cujo nome e prefixo do da imagem sequestrava o `run`.
        # Nome EXATO: `docker run python` nao pode cair no `python-web`.
        ctr = resolve_container(alvo, prefixo=False)
        reusando = bool(ctr)

    if reusando:
        aviso("%s e um container que ja existe (nao uma imagem): rodando nele. "
              "Para comando dentro dele use `docker exec %s <cmd>`." % (alvo, alvo))
        if remover:
            aviso("--rm ignorado aqui de proposito: apagar um container nomeado "
                  "destroi o que voce instalou dentro; use `docker rm %s`." % alvo)
            remover = False

    if ctr is None:
        if not garantir_imagem(alvo, opts.get("--platform")):
            return 1
        if detach and not nome:
            # HHMMSS sozinho colidia em dois -d no mesmo segundo
            nome = "ctr-%s-%s" % (time.strftime("%H%M%S"), secrets.token_hex(2))
        cid = criar_container(alvo, nome)
        if not cid:
            return 1
        ctr = resolve_container(cid) or os.path.join(CONTAINERS, cid)
        alvo_container = nome or os.path.basename(os.path.realpath(ctr))
    else:
        alvo_container = os.path.basename(os.path.realpath(ctr))

    def limpar():
        if remover:
            remover_container(alvo_container)

    try:
        fix_dns(alvo_container)

        flags = montar_flags_udocker(opts, multi, comando)

        caminho_ctr = resolve_container(alvo_container, prefixo=False)
        if caminho_ctr and precisa_qemu(caminho_ctr) and os.path.isdir("/linkerconfig"):
            # Sem isto o qemu (binario Android) imprime, a cada processo filho,
            # "WARNING: linker: failed to find ... ld.config.txt" — o proot nao
            # tem esse diretorio do sistema Android dentro do rootfs.
            flags += ["-v", "/linkerconfig:/linkerconfig"]
        args = ["run", "--nobanner"] + flags + [alvo_container] + comando
    except BaseException:
        limpar()
        raise

    if detach:
        os.makedirs(LOGDIR, exist_ok=True)
        log = log_path(alvo_container)
        with open(log, "wb") as f:
            p = subprocess.Popen([UDOCKER] + args, env=ambiente(),
                                 stdout=f, stderr=subprocess.STDOUT,
                                 stdin=subprocess.DEVNULL, start_new_session=True)
        # rm: o docker remove o container quando ele para; aqui isso acontece
        # no `docker stop` (ou no proximo `docker ps`, se ele sair sozinho)
        gravar_state(alvo_container, {"pid": p.pid, "starttime": starttime(p.pid),
                                      "log": log, "iniciado": time.time(),
                                      "rm": remover})
        print(alvo_container)
        info("rodando em background (pid %d) — docker logs %s" % (p.pid, alvo_container))
        return 0

    return rodar_primeiro_plano(args, limpar)


def cmd_exec(argv):
    # mesmas flags do run (-it, -e, -u, -w, --env-file); antes `exec -it web sh`
    # dava "container nao encontrado: -it"
    opts, multi, alvo, comando = parse_exec_style(argv)
    if not alvo or not comando:
        err("uso: docker exec [-it] [-e VAR=val] [-u uid] [-w dir] <container> <comando> [args]")
        return 2
    if opts.get("-d"):
        err("`docker exec -d` nao existe no modo direto; use `docker run -d` "
            "ou rode em primeiro plano")
        return 2
    aceitas = {"-e", "--env", "-u", "--user", "-w", "--workdir", "--env-file",
               "-i", "-t", "--interactive", "--tty", "-d", "--detach"}
    ignoradas = sorted(k for k in opts if k not in aceitas)
    if ignoradas or multi.get("-v") or multi.get("--mount") or multi.get("-p"):
        aviso("opcoes ignoradas no exec: %s"
              % " ".join(ignoradas + (["-v"] if multi.get("-v") else [])
                         + (["--mount"] if multi.get("--mount") else [])
                         + (["-p"] if multi.get("-p") else [])))
    ctr = resolve_container(alvo)
    if not ctr:
        err("container nao encontrado: %s" % alvo)
        return 1
    fix_dns(os.path.basename(ctr))
    so = {k: v for k, v in opts.items() if k in aceitas}
    flags = montar_flags_udocker(so, {"-e": multi.get("-e", [])}, comando)
    return udocker(["run", "--nobanner"] + flags + [os.path.basename(ctr)] + comando)


def _alvos_e_flags(argv, com_valor, booleanas, uso):
    """Separa flags simples de `logs`/`stop`/`rm` dos nomes de container."""
    valores, ligadas, alvos = {}, set(), []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a.startswith("--") and "=" in a:
            k, _, v = a.partition("=")
            if k not in com_valor:
                err("opcao desconhecida: %s — %s" % (k, uso))
                sys.exit(2)
            valores[k] = v
        elif a in com_valor:
            if i + 1 >= len(argv):
                err("opcao %s exige um valor" % a)
                sys.exit(2)
            i += 1
            valores[a] = argv[i]
        elif a in booleanas:
            ligadas.add(a)
        elif a.startswith("-") and len(a) > 1 and not a.startswith("--") \
                and all("-" + c in booleanas for c in a[1:]):
            ligadas.update("-" + c for c in a[1:])
        elif a.startswith("-") and len(a) > 1:
            err("opcao desconhecida: %s — %s" % (a, uso))
            sys.exit(2)
        else:
            alvos.append(a)
        i += 1
    return valores, ligadas, alvos


def cmd_logs(argv):
    uso = "uso: docker logs [-f] [-n N|--tail N] <container>"
    valores, ligadas, alvos = _alvos_e_flags(
        argv, {"-n", "--tail", "--since", "--until"},
        {"-f", "--follow", "-t", "--timestamps", "--details"}, uso)
    if len(alvos) != 1:
        err(uso)
        return 2
    nome = alvos[0]
    ignoradas = sorted(k for k in valores if k in ("--since", "--until")) \
        + sorted(k for k in ligadas if k in ("-t", "--timestamps", "--details"))
    if ignoradas:
        aviso("ignorado no modo direto (o log nao tem horario): %s" % " ".join(ignoradas))
    st = ler_state(nome)
    if not st:
        caminho = resolve_container(nome)
        for n in (nomes_do_container(caminho) if caminho else ()):
            st = ler_state(n)
            if st:
                break
    log = st.get("log")
    if not log or not os.path.exists(log):
        err("sem log para %s (so containers de `run -d` guardam saida)" % nome)
        return 1
    cauda = valores.get("-n", valores.get("--tail", "all"))
    if cauda != "all":
        try:
            cauda = max(int(cauda), 0)
        except ValueError:
            err("--tail exige um numero ou 'all': %r" % cauda)
            return 2
    if "-f" in ligadas or "--follow" in ligadas:
        n = "+1" if cauda == "all" else str(cauda)
        return subprocess.call(["tail", "-n", n, "-f", log])
    with open(log, "rb") as f:
        linhas = f.read().decode("utf-8", "replace").splitlines(True)
    if cauda != "all":
        linhas = linhas[-cauda:] if cauda else []
    sys.stdout.write("".join(linhas))
    return 0


def cmd_stop(argv):
    uso = "uso: docker stop [-t SEGUNDOS] [-s SINAL] <container>..."
    valores, _, alvos = _alvos_e_flags(
        argv, {"-t", "--time", "--timeout", "-s", "--signal"}, set(), uso)
    if not alvos:
        err(uso)
        return 2
    espera = valores.get("-t", valores.get("--time", valores.get("--timeout", "5")))
    try:
        espera = max(float(espera), 0.0)
    except ValueError:
        err("-t exige segundos: %r" % espera)
        return 2
    nome_sinal = valores.get("-s", valores.get("--signal", "SIGTERM")).upper()
    if nome_sinal.isdigit():
        sinal = int(nome_sinal)
    else:
        sinal = getattr(signal, nome_sinal if nome_sinal.startswith("SIG")
                        else "SIG" + nome_sinal, None)
        if sinal is None:
            err("sinal desconhecido: %s" % nome_sinal)
            return 2
    rc = 0
    for nome in alvos:
        rc = _parar(nome, sinal, espera) or rc
    return rc


def _parar(nome, sinal, espera):
    st = ler_state(nome)
    if not st:
        caminho = resolve_container(nome)
        for n in (nomes_do_container(caminho) if caminho else ()):
            if ler_state(n):
                nome, st = n, ler_state(n)
                break
    pid = st.get("pid")
    if not pid or not pid_vivo(pid):
        aviso("%s nao esta rodando em background" % nome)
        if st.get("rm"):
            remover_container(nome)
        return 1
    if not mesmo_processo(pid, st):
        # reboot recicla PIDs: matar aqui seria matar um processo INOCENTE
        aviso("%s: pid %d reciclado pelo sistema — estado antigo descartado, "
              "nada foi sinalizado" % (nome, pid))
        gravar_state(nome, {"log": st.get("log"), "parado": True})
        return 1
    encerrar(pid, sinal, espera)
    if st.get("rm"):
        # `run -d --rm`: o docker remove o container quando ele para
        remover_container(nome)
        info("%s encerrado e removido (--rm)" % nome)
        return 0
    # o log sobrevive ao stop (igual ao docker): apagar o state faria o
    # proximo `docker logs` responder "sem log"
    gravar_state(nome, {"log": st.get("log"), "pid": st.get("pid"),
                        "parado": True, "iniciado": st.get("iniciado")})
    info("%s encerrado" % nome)
    return 0


def cmd_rm(argv):
    uso = "uso: docker rm [-f] <container>..."
    _, ligadas, alvos = _alvos_e_flags(
        argv, set(), {"-f", "--force", "-v", "--volumes", "-l", "--link"}, uso)
    if not alvos:
        err(uso)
        return 2
    forcar = bool(ligadas & {"-f", "--force"})
    rc = 0
    for alvo in alvos:
        caminho = resolve_container(alvo)
        if not caminho:
            err("container nao encontrado: %s" % alvo)
            rc = 1
            continue
        nomes = nomes_do_container(caminho) | {alvo}
        vivos = [(n, ler_state(n)) for n in sorted(nomes) if processo_vivo(ler_state(n))]
        if vivos and not forcar:
            # antes o rootfs era apagado com o proot rodando dentro dele
            err("%s esta rodando (pid %d): pare com `docker stop %s` ou use "
                "`docker rm -f %s`" % (alvo, vivos[0][1]["pid"], alvo, alvo))
            rc = 1
            continue
        for _, st in vivos:
            encerrar(st["pid"], getattr(signal, "SIGKILL", signal.SIGTERM), 2.0)
        r = udocker(["rm", os.path.basename(caminho)])
        if r != 0:
            rc = r
            continue
        # state e log de TODOS os nomes (antes so o do 1o argumento)
        for n in nomes:
            apagar_state(n, com_log=True)
    return rc


def cmd_rmi(argv):
    if not argv:
        err("uso: docker rmi <imagem>[:tag]")
        return 2
    return udocker(["rmi"] + argv)


def cmd_search(argv):
    return udocker(["search"] + argv)


def cmd_inspect(argv):
    if not argv:
        err("uso: docker inspect <container|imagem>")
        return 2
    ctr = resolve_container(argv[0])
    if ctr:
        caminho = os.path.join(ctr, "container.json")
        try:
            with open(caminho) as f:
                print(json.dumps(json.load(f), indent=2))
            return 0
        except (OSError, ValueError):
            pass
    return udocker(["inspect", "-p", argv[0]])


def cmd_dns_fix(argv=None):
    n = fix_dns_todos()
    info("resolv.conf aplicado em %d container(s)" % n)
    return 0


def cmd_doctor(argv=None):
    ok = True
    print(cor("docker (Termux) — diagnostico", AZUL))

    def checa(rotulo, condicao, detalhe=""):
        nonlocal ok
        marca = cor("OK  ", VERDE) if condicao else cor("FALHA", VERM)
        print("  [%s] %s %s" % (marca, rotulo, detalhe))
        if not condicao:
            ok = False

    checa("runtime udocker", os.path.exists(UDOCKER), UDOCKER)
    checa("repo udocker", os.path.isdir(CONTAINERS), CONTAINERS)

    shim = os.path.join(REPO, "bin", "proot-arm64-4_8_0")
    conteudo = ""
    if os.path.exists(shim):
        with open(shim, "rb") as f:
            conteudo = f.read(8192).decode("utf-8", "replace")
    checa("shim do proot (5.1 + link2symlink)",
          "link2symlink" in conteudo and "files/usr/bin/proot" in conteudo)

    try:
        v = subprocess.run([os.path.join(PREFIX, "bin", "proot"), "--version"],
                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           text=True, env=ambiente()).stdout.splitlines()
        checa("proot do Termux", bool(v), v[0] if v else "")
    except OSError:
        checa("proot do Termux", False, "instale: pkg install proot")

    qemu = shutil.which("qemu-x86_64")
    checa("qemu-x86_64 (imagens amd64)", bool(qemu), qemu or "pkg install qemu-user-x86-64")

    patch = ""
    arq = os.path.join(BASE, "udocker-" + VERSAO_UDOCKER, "udocker", "engine", "proot.py")
    if os.path.exists(arq):
        with open(arq) as f:
            patch = f.read()
    checa("patch qemu com caminho absoluto", "PATCH ANDROID" in patch)

    # camada daemon (opcional): CLI oficial do docker + udockerd
    cli = os.path.join(BASE, "bin", "docker")
    checa("CLI oficial do docker", os.path.exists(cli),
          subprocess.run([cli, "--version"], stdout=subprocess.PIPE, text=True).stdout.strip()
          if os.path.exists(cli) else "rode docker-termux-setup")

    sup = glob.glob(os.path.join(HOME, ".udockerd", "udockerd-supervisor-*"))
    checa("supervisor do daemon compilado", bool(sup),
          "sem ele `docker logs` do container principal fica vazio")

    daemon_ok = False
    # o daemon escuta num socket Unix (0600) por padrao: TCP no loopback fica
    # alcancavel por qualquer app do Android, e a API do Docker nao autentica.
    sock = os.environ.get("UDOCKERD_SOCKET", os.path.join(HOME, ".udockerd", "docker.sock"))
    onde = f"unix://{sock}"
    try:
        if os.environ.get("DOCKER_DAEMON_TCP", "0") == "1":
            import urllib.request
            onde = "tcp://127.0.0.1:2375"
            with urllib.request.urlopen(f"http://127.0.0.1:2375/_ping", timeout=2) as r:
                daemon_ok = r.read().decode().strip() == "OK"
        else:
            import http.client
            import socket as _socket

            class _UnixHTTP(http.client.HTTPConnection):
                def __init__(self) -> None:
                    super().__init__("localhost", timeout=2)

                def connect(self) -> None:
                    self.sock = _socket.socket(_socket.AF_UNIX, _socket.SOCK_STREAM)
                    self.sock.settimeout(2)
                    self.sock.connect(sock)

            c = _UnixHTTP()
            c.request("GET", "/_ping")
            daemon_ok = c.getresponse().read().decode().strip() == "OK"
            c.close()
    except Exception:
        daemon_ok = False
    checa("daemon (API do Docker)", daemon_ok,
          f"no ar em {onde}" if daemon_ok else "parado — sobe sozinho no proximo docker run")

    ns = [n for n in sorted(containers_locais())]
    sem_dns = [n for n in ns
               if not os.path.exists(os.path.join(CONTAINERS, n, "ROOT", "etc", "resolv.conf"))]
    # container criado pelo daemon recebe DNS por conta dele: so o modo direto usa arquivo
    checa("dns dos containers", not sem_dns or daemon_ok,
          "%d container(s)" % len(ns)
          + (" — sem arquivo no modo direto: " + ", ".join(sem_dns) if sem_dns and not daemon_ok else ""))

    livre = shutil.disk_usage(HOME).free / 1e9
    checa("espaco livre", livre > 2, "%.1f GB" % livre)

    print()
    print(cor("Tudo pronto." if ok else "Rode: docker-termux-setup para corrigir.", VERDE if ok else AMAR))
    return 0 if ok else 1


def cmd_info(argv=None):
    print("motor      : udocker %s + proot 5.1 (userspace, sem root)" % VERSAO_UDOCKER)
    print("dns        : %s (DOCKER_TERMUX_DNS)" % " ".join(NOMES_DNS))
    print("repo       : %s" % REPO)
    print("runtime    : %s" % BASE)
    print("containers : %d" % len(containers_locais()))
    plat = "arm64 nativo"
    if shutil.which("qemu-x86_64"):
        plat += " + amd64 emulado (qemu)"
    print("plataforma : %s" % plat)
    try:
        livre = shutil.disk_usage(HOME).free / 1e9
        usado = subprocess.run(["du", "-sh", REPO], stdout=subprocess.PIPE,
                               text=True).stdout.split()[0]
        print("disco      : %s usados pelo repo, %.1f GB livres" % (usado, livre))
    except (OSError, IndexError, ValueError):
        pass
    return 0


COMANDOS = {
    "help": cmd_help, "--help": cmd_help, "-h": cmd_help,
    "pull": cmd_pull, "images": cmd_images, "ps": cmd_ps,
    "create": cmd_create, "run": cmd_run, "exec": cmd_exec,
    "logs": cmd_logs, "stop": cmd_stop, "rm": cmd_rm, "rmi": cmd_rmi,
    "search": cmd_search, "inspect": cmd_inspect,
    "version": cmd_version, "--version": cmd_version,
    "doctor": cmd_doctor, "info": cmd_info, "dns-fix": cmd_dns_fix,
}


def main():
    argv = sys.argv[1:]
    if not argv:
        cmd_help()
        return 0
    nome = argv[0]
    fn = COMANDOS.get(nome)
    if not fn:
        if nome in ("start", "restart", "attach", "build", "compose",
                    "push", "login", "network", "volume", "logs"):
            err("`docker %s` nao existe neste modo (sem daemon). "
                "Veja `docker help`." % nome)
            return 2
        err("comando desconhecido: %s — veja `docker help`" % nome)
        return 2
    try:
        return fn(argv[1:]) or 0
    except KeyboardInterrupt:
        return 130
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    sys.exit(main())
