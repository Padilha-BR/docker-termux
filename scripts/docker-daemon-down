#!/data/data/com.termux/files/usr/bin/bash
# docker-daemon-down — encerra o daemon udockerd e os containers que ele subiu.
#
# Os containers sao processos proot filhos do daemon; encerrar o grupo de
# processos do daemon (killpg) leva todos junto, evitando orfaos.

set -u
BASE="${DOCKER_TERMUX_HOME:-$HOME/docker-termux}"
PIDFILE="$BASE/state/udockerd.pid"
PORTA="${DOCKER_DAEMON_PORT:-2375}"

# PID + starttime: o pidfile guarda "pid starttime" (campo 22 do
# /proc/<pid>/stat). Depois de um reboot o numero e reciclado; sem conferir a
# assinatura, o down mandava SIGTERM para o GRUPO de um processo inocente
# (o docker-direct ja fazia essa conferencia; o daemon nao).
starttime_de() {
    local linha
    linha=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
    linha="${linha##*) }"           # o nome do processo pode ter espaco e ')'
    # shellcheck disable=SC2086
    set -- $linha
    [ $# -ge 20 ] && printf '%s' "${20}"
}

# imprime o pid do pidfile SE ele ainda for o mesmo processo e for o udockerd
pid_do_daemon() {
    local pid st atual
    [ -f "$PIDFILE" ] || return 1
    read -r pid st < "$PIDFILE" 2>/dev/null || return 1
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    atual=$(starttime_de "$pid") || return 1
    if [ -n "$st" ] && [ "$st" != "$atual" ]; then
        return 1                    # numero reciclado: nao e mais o nosso
    fi
    tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q udockerd || return 1
    printf '%s' "$pid"
}

if [ ! -f "$PIDFILE" ]; then
    echo "sem pidfile — daemon provavelmente ja parado"
    exit 0
fi

if ! pid=$(pid_do_daemon); then
    # morto, ou o numero foi reciclado (reboot) por outro processo: NADA e
    # sinalizado — killpg num pid reciclado derrubaria um grupo inocente
    echo "daemon ja estava parado (pidfile velho descartado, nada sinalizado)"
    rm -f "$PIDFILE"
    exit 0
fi

pkill -TERM -P "$pid" 2>/dev/null || true
kill -TERM "-$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ')" 2>/dev/null || kill -TERM "$pid" 2>/dev/null

for _ in $(seq 1 20); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.25
done

if kill -0 "$pid" 2>/dev/null; then
    kill -KILL "-$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ')" 2>/dev/null || kill -KILL "$pid" 2>/dev/null
fi

rm -f "$PIDFILE"
SOCKET="${UDOCKERD_SOCKET:-$HOME/.udockerd/docker.sock}"
TCP="${DOCKER_DAEMON_TCP:-0}"
if [ "$TCP" = 1 ]; then
    if curl -s -m 2 "http://127.0.0.1:$PORTA/_ping" >/dev/null 2>&1; then
        echo "aviso: algo ainda responde na porta $PORTA" >&2
        exit 1
    fi
else
    if curl -s -m 2 --unix-socket "$SOCKET" http://localhost/_ping >/dev/null 2>&1; then
        echo "aviso: algo ainda responde no socket $SOCKET" >&2
        exit 1
    fi
    # socket de daemon morto: sem remover, o proximo bind falha com "address in use"
    rm -f "$SOCKET" 2>/dev/null || true
fi
# o wake-lock e tomado no docker-daemon-up e ninguem devolvia: depois do
# primeiro comando `docker` o aparelho nunca mais dormia
termux-wake-unlock 2>/dev/null || true
echo "daemon encerrado"
