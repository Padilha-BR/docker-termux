#!/data/data/com.termux/files/usr/bin/bash
# Ponto de entrada do repositorio.
#
# O instalador de verdade vive em scripts/docker-termux-setup — este arquivo so
# chama ele. Antes existiam DUAS copias identicas (aqui e em scripts/), que iam
# divergir na primeira edicao de uma so. Agora ha uma fonte, e o README continua
# podendo dizer `bash docker-termux-setup`.
#
# Uso:  bash docker-termux-setup [--force]
set -eu
exec "$(cd "$(dirname "$0")" && pwd)/scripts/docker-termux-setup" "$@"
