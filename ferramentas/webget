#!/data/data/com.termux/files/usr/bin/bash
# webget — baixa uma pagina e extrai o conteudo (NIVEL 1: sem navegador).
#
# Barato e rapido (~1 s, ~30 MB de RAM): HTTP + parser. Use PRIMEIRO. Se o texto
# vier vazio, a pagina renderiza via JavaScript — aí e `webprint` (Chromium) ou
# `webplay` (Playwright).
#
# Uso:
#   webget https://exemplo.com
#   webget https://exemplo.com --links
#   webget https://exemplo.com --seletor "article" -o artigo.md
#   webget https://exemplo.com --json

# Binds: o udocker NAO suporta ':ro' (vira parte do nome do arquivo). Use -v orig:dest.
set -uo pipefail

IMG="web:1"
FONTE="$HOME/docker-termux/imagens/web-leve"

erro() { printf 'erro: %s\n' "$*" >&2; exit 2; }

case "${1:-}" in
    ""|-h|--help|--ajuda)
        sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
        exit 2
        ;;
esac

if ! docker image inspect "$IMG" >/dev/null 2>&1; then
    echo "==> imagem $IMG ausente; construindo (1-2 min)" >&2
    [ -f "$FONTE/Dockerfile" ] || erro "Dockerfile nao encontrado em $FONTE"
    (cd "$FONTE" && docker build -q -t "$IMG" . >&2) || erro "falha ao construir $IMG"
fi

exec docker-direct run --rm \
    --entrypoint python3 \
    -v "$PWD:/dados" \
    -v "$FONTE/webget.py:/webget.py" \
    -w /dados \
    -e PYTHONUNBUFFERED=1 \
    "$IMG" /webget.py "$@"
